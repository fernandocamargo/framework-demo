{
  // On save, ESLint sorts (imports in three groups, keys, props: eslint.config.mjs), then oxfmt
  // lays the file out (.oxfmtrc.json). `npm run check` fails on a file left unsorted or unformatted.
  // The Oxc extension also shows Oxlint's anti-slop findings (.oxlintrc.json) as you type.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  // The framework's TypeScript plugin types what the framework injects. It loads only in the
  // project's own TypeScript, so VS Code offers to switch to it once (framework/README.md, Editors).
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsdk": "node_modules/typescript/lib"
}
